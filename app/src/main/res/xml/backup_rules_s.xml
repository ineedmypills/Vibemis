<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <!-- Don't sync preferences, pairing keys/certs, or host database across devices -->
  <cloud-backup disableIfNoEncryptionCapabilities="true">
    <exclude domain="sharedpref" path="."/>
    <exclude domain="file" path="client.key"/>
    <exclude domain="file" path="client.crt"/>
    <exclude domain="database" path="computers4.db"/>
    <exclude domain="database" path="computers4.db-wal"/>
    <exclude domain="database" path="computers4.db-shm"/>
    <exclude domain="database" path="computers4.db-journal"/>
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="file" path="client.key"/>
    <exclude domain="file" path="client.crt"/>
    <exclude domain="database" path="computers4.db"/>
    <exclude domain="database" path="computers4.db-wal"/>
    <exclude domain="database" path="computers4.db-shm"/>
    <exclude domain="database" path="computers4.db-journal"/>
  </device-transfer>
</data-extraction-rules>