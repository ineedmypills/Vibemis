<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />
    
    <com.ineedmypills.vibemis.ui.StreamContainer
        android:id="@+id/streamContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true">
    <requestFocus />
    </com.ineedmypills.vibemis.ui.StreamContainer>

    <!--
        Opt-in Android TV compatibility layer. Some TV firmware becomes unstable
        when the video SurfaceView is the only visible layer. Game controls its
        visibility and periodically changes this pixel independently of the HUD.
    -->
    <View
        android:id="@+id/tvCompositorHeartbeat"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="start|top"
        android:background="#FF000000"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />


    <TextView
        android:id="@+id/notificationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="end"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:gravity="end"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/performanceOverlay"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/performanceOverlayBig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_gravity="start"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start"
            android:background="#80000000"
            android:preferKeepClear="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/performanceOverlayLite"
            tools:text="延迟/解码：109ms/7ms 丢包率：69% FPS：60"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:background="@drawable/ic_hud_bg"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/performanceOverlayMini"
            tools:text="BW: 109M/s PL: 0% Net: 7ms | Dec: 109ms XX.XX FPS"
            android:textSize="8sp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:textColor="#CCFFFFFF"
            android:layout_gravity="start|top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- Floating Menu Button -->
    <ImageButton
        android:id="@+id/floatingMenuButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="18dp"
        android:background="@drawable/floating_menu_button"
        android:contentDescription="@string/menu_button"
        android:src="@drawable/ic_menu"
        android:padding="12dp"
        android:visibility="gone"
        android:elevation="9999dp" />

    <ImageButton
        android:id="@+id/overlayToggleZoomButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@drawable/floating_menu_button"
        android:src="@drawable/ic_zoom_toggle"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/toggle_pan_zoom_mode"
        android:visibility="gone"
        android:elevation="9999dp" />

</merge>
